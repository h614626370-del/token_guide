NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Generate independent random values. Session password must be at least 32 characters.
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
NUXT_ADMIN_TOKEN=replace-with-a-random-administrator-token
NUXT_IP_HASH_SALT=replace-with-a-random-ip-hash-salt

NUXT_DATABASE_PATH=/data/guide.sqlite
NUXT_APP_VERSION=2.2.23
NUXT_UPDATE_IMAGE_REPOSITORY=614626370/sub2api-guide
NUXT_UPDATE_GITHUB_REPO=h614626370-del/token_guide
NUXT_UPDATE_CONTAINER_NAME=sub2api-guide
NUXT_DOCKER_SOCKET_PATH=/var/run/docker.sock
NUXT_SUB2API_ADMIN_API_KEY=
NUXT_PRICING_PLATFORMS=openai,anthropic,gemini,antigravity,grok
NUXT_PRICING_CACHE_TTL_MS=300000
NUXT_UPSTREAM_TIMEOUT_MS=8000
NUXT_PLAYGROUND_TEXT_TIMEOUT_MS=120000
NUXT_PLAYGROUND_IMAGE_TIMEOUT_MS=300000
NUXT_FEEDBACK_DAILY_LIMIT=5
NUXT_RATE_WINDOW_MS=600000
NUXT_RATE_MAX=5
NUXT_COMMUNITY_LIKE_WINDOW_MS=60000
NUXT_COMMUNITY_LIKE_MAX=30
NUXT_USD_TO_CNY=6.8102

# Exact IPs of reverse proxies allowed to supply X-Forwarded-For.
NUXT_TRUSTED_PROXY_IPS=127.0.0.1,::1
