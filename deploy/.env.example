NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# 宿主机映射端口（compose 使用）
HOST_PORT=3000
# 宿主机绑定地址；0.0.0.0 允许通过服务器 IP 直连，127.0.0.1 仅允许本机 Nginx 代理
HOST_BIND_ADDRESS=0.0.0.0
# 镜像仓库；默认始终拉取 latest，不在 .env 固化版本号
IMAGE_REPOSITORY=614626370/sub2api-guide
# 宿主机 docker.sock 组 ID（docker-deploy.sh 会自动探测）
DOCKER_GID=0

# 站点与主站
NUXT_PUBLIC_SITE_URL=https://guide.kkflow.org
NUXT_PUBLIC_SUB2API_ORIGIN=https://kkflow.org
NUXT_PUBLIC_PROJECT_NAME=Token向云
NUXT_PUBLIC_SITE_NAME=Token向云指南
NUXT_PUBLIC_SITE_DESCRIPTION=会员、API 接入、模型试用与价格参考。
NUXT_PUBLIC_LOGO_PATH=https://guide.kkflow.org/logo-80.png
NUXT_PUBLIC_FOOTER_TEXT=清晰接入，稳定调用。
NUXT_PUBLIC_LOGIN_PATH=/login
NUXT_PUBLIC_REGISTER_PATH=/register
NUXT_PUBLIC_SUPPORT_PATH=/support
NUXT_PUBLIC_API_PATH=/v1
NUXT_PUBLIC_SUPPORT_WECHAT=
NUXT_PUBLIC_SUPPORT_GROUP_URL=

# 以下三项由 docker-deploy.sh 自动生成，请妥善保存
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
NUXT_ADMIN_TOKEN=replace-with-a-random-administrator-token
NUXT_IP_HASH_SALT=replace-with-a-random-ip-hash-salt

NUXT_DATABASE_PATH=/data/guide.sqlite
# 首页默认模板：自由home，可选 ziyou / xiangyun / linglian
NUXT_HOMEPAGE_DEFAULT_ID=ziyou
NUXT_UPDATE_IMAGE_REPOSITORY=614626370/sub2api-guide
NUXT_UPDATE_GITHUB_REPO=h614626370-del/token_guide
NUXT_UPDATE_CONTAINER_NAME=sub2api-guide
NUXT_DOCKER_SOCKET_PATH=/var/run/docker.sock
NUXT_SUB2API_ADMIN_API_KEY=
NUXT_PRICING_PLATFORMS=openai,anthropic,gemini,antigravity,grok
NUXT_PRICING_CACHE_TTL_MS=300000
NUXT_UPSTREAM_TIMEOUT_MS=8000
NUXT_PLAYGROUND_TEXT_TIMEOUT_MS=120000
NUXT_PLAYGROUND_IMAGE_TIMEOUT_MS=300000
NUXT_FEEDBACK_DAILY_LIMIT=5
NUXT_RATE_WINDOW_MS=600000
NUXT_RATE_MAX=5
NUXT_USD_TO_CNY=6.8102
NUXT_TRUSTED_PROXY_IPS=127.0.0.1,::1
